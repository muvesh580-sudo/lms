PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/lms
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# Razorpay test keys (https://dashboard.razorpay.com/app/keys). Paid enrollment
# is disabled until these are set; free courses still work without them.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Used only by `npm run create-admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please

# Set to 1 when deployed behind a proxy/load balancer (Render, Railway, Heroku...)
# TRUST_PROXY=1
